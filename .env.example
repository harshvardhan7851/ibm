# ==============================================================================
# BobPulse configuration — copy to .env and fill in what you need.
#
# Every setting is optional. With no .env at all, BobPulse runs the
# deterministic transformer and all analysis features work.
# ==============================================================================


# ── IBM watsonx.ai (optional — enables model-driven synthesis) ────────────────
#
# Requires the SDK:  pip install "ibm-watsonx-ai>=1.0,<2.0"
#
# 1. API key      → https://cloud.ibm.com/iam/apikeys  (shown once — copy it)
# 2. Project ID   → https://dataplatform.cloud.ibm.com/projects
#                   open the project → Manage → General → Project ID
# 3. Associate a watsonx.ai Runtime service instance with that project, or
#    inference returns 403.
#
# Both values must be set. If either is missing, BobPulse reports
# mode="rule-engine" on /api/health and uses the transformer.

IBM_WATSONX_APIKEY=your_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here

# Regional inference endpoint — must match the region of your project.
#   https://us-south.ml.cloud.ibm.com   Dallas
#   https://eu-de.ml.cloud.ibm.com      Frankfurt
#   https://eu-gb.ml.cloud.ibm.com      London
#   https://jp-tok.ml.cloud.ibm.com     Tokyo
#   https://au-syd.ml.cloud.ibm.com     Sydney
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Pin a specific foundation model. Leave unset to let BobPulse resolve one
# against the models your account actually exposes — models get withdrawn, and
# a hardcoded id eventually starts returning 404.
# IBM_WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct


# ── Pipeline ─────────────────────────────────────────────────────────────────

# Synthesis attempts before giving up. Each rejected attempt is sent back to the
# model with the verifier's report attached. Range 1-6, default 3.
# BOBPULSE_MAX_ATTEMPTS=3


# ── Verification ─────────────────────────────────────────────────────────────

# Additionally IMPORT the modernized module to catch import-time errors.
#
# WARNING: this EXECUTES the submitted source. Any module-level statement in the
# code being analysed will run with the privileges of this process. Only enable
# it inside a disposable container. Off by default.
# BOBPULSE_ALLOW_EXEC=0


# ── HTTP ─────────────────────────────────────────────────────────────────────

# CORS origins, comma separated. Leave unset when the bundled UI is used — it is
# served by the same app, so no cross-origin access is involved and no CORS
# headers are sent. Only set this if you host a frontend separately.
# BOBPULSE_CORS_ORIGINS=http://localhost:5173
